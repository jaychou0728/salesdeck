PORT=3000
DATABASE_URL=./data/app.db
DEMO_MODE=true
CONFIRMATION_SECRET=change-me-in-local
EMBEDDING_PROVIDER=local

# ---------------------------------------------------------------
# LLM 接入：任何 OpenAI 兼容端点都能用
# mock | deepseek | openai | qwen | kimi | zhipu | siliconflow | openrouter | groq | ollama | litellm | 自定义名称
# ---------------------------------------------------------------
LLM_PROVIDER=mock
# 覆盖供应商默认端点（如 LiteLLM 代理 http://127.0.0.1:4000/v1）
LLM_BASE_URL=
# 通用 Key；也可使用下方供应商专用变量
LLM_API_KEY=
LLM_MODEL=
LLM_MAX_TOKENS=800
LLM_TIMEOUT_MS=30000
# 额外请求头，JSON 对象，例如 OpenRouter：
# LLM_EXTRA_HEADERS={"HTTP-Referer":"https://example.com","X-Title":"SalesDeck"}
LLM_EXTRA_HEADERS=

# 供应商专用 Key（按需填写，设置 LLM_PROVIDER 后自动读取）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
OPENAI_API_KEY=
DASHSCOPE_API_KEY=
MOONSHOT_API_KEY=
ZHIPU_API_KEY=
SILICONFLOW_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
LITELLM_MASTER_KEY=
